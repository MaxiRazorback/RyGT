From c2e584c3d6e23ce7f7bf192d573129a960f90063 Mon Sep 17 00:00:00 2001
From: mlgprorektm8 <67933lance@gmail.com>
Date: Tue, 20 Oct 2026 12:02:10 -0500
Subject: [PATCH 43/43] Load under Wine 10 / Proton 10: CreateFileMappingW
 instead of CreateFileMapping2

Wine and Proton before 11 don't export CreateFileMapping2, and every host library imports it
through the shared core code, so none of them loaded there. Both calls pass no extended
parameters, which makes them the same as CreateFileMappingW.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common/io_file.cpp     | 4 ++--
 src/core/address_space.cpp | 8 +++++---
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/src/common/io_file.cpp b/src/common/io_file.cpp
index 249d0e0f..6847e2b9 100644
--- a/src/common/io_file.cpp
+++ b/src/common/io_file.cpp
@@ -266,8 +266,8 @@ uintptr_t IOFile::GetFileMapping() {
     HANDLE mapping = nullptr;
 
     if (file_access_mode == FileAccessMode::ReadWrite) {
-        mapping = CreateFileMapping2(hfile, NULL, FILE_MAP_WRITE, PAGE_READWRITE, SEC_COMMIT, 0,
-                                     NULL, NULL, 0);
+        // (CreateFileMappingW rather than CreateFileMapping2, which Wine 10 / Proton 10 lack.)
+        mapping = CreateFileMappingW(hfile, NULL, PAGE_READWRITE | SEC_COMMIT, 0, 0, NULL);
     } else {
         mapping = hfile;
     }
diff --git a/src/core/address_space.cpp b/src/core/address_space.cpp
index 4318a0c1..1cefd0cd 100644
--- a/src/core/address_space.cpp
+++ b/src/core/address_space.cpp
@@ -195,9 +195,11 @@ struct AddressSpace::Impl {
                        EmulatorSettings.GetExtraFmemInMBytes() * 1_MB;
 
         // Allocate backing file that represents the total physical memory.
-        backing_handle = CreateFileMapping2(INVALID_HANDLE_VALUE, nullptr, FILE_MAP_ALL_ACCESS,
-                                            PAGE_EXECUTE_READWRITE, SEC_COMMIT, BackingSize,
-                                            nullptr, nullptr, 0);
+        // (CreateFileMappingW rather than CreateFileMapping2, which Wine 10 / Proton 10 lack.)
+        backing_handle = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr,
+                                            PAGE_EXECUTE_READWRITE | SEC_COMMIT,
+                                            static_cast<DWORD>(BackingSize >> 32),
+                                            static_cast<DWORD>(BackingSize), nullptr);
 
         ASSERT_MSG(backing_handle, "{}", Common::GetLastErrorMsg());
         // Allocate a virtual memory for the backing file map as placeholder
-- 
