diff --git a/ryty_gpu/ryty_hdr_ui.h b/ryty_gpu/ryty_hdr_ui.h
new file mode 100644
index 00000000..d4fcb99a
--- /dev/null
+++ b/ryty_gpu/ryty_hdr_ui.h
@@ -0,0 +1,44 @@
+#pragma once
+
+// HDR-UI (ryGT): GT Sport draws its HUD and menus into the HDR10 display buffer with SDR colours
+// (no PQ encoding in its UI shaders), so their white came out at 10000 nits and colours clipped.
+// Draws that blend into a display buffer while the game outputs HDR get a PQ encoding epilogue
+// (sRGB to linear, the UI white in nits, BT.709 to BT.2020, PQ) through the pipeline key.
+
+#include <array>
+#include <atomic>
+
+#include "common/types.h"
+
+namespace Ryty {
+
+inline std::atomic<bool> g_hdr_output{false};
+/// UI-HIRES has a proxy (and so a UI layer) for the display buffers.
+inline std::atomic<bool> g_ui_layer_ready{false};
+inline std::array<std::atomic<u64>, 16> g_display_addresses{};
+
+inline void AddDisplayAddress(u64 address) {
+    if (address == 0) {
+        return;
+    }
+    for (auto& known : g_display_addresses) {
+        u64 seen = known.load(std::memory_order_relaxed);
+        if (seen == address) {
+            return;
+        }
+        if (seen == 0 && known.compare_exchange_strong(seen, address)) {
+            return;
+        }
+    }
+}
+
+inline bool IsDisplayAddress(u64 address) {
+    for (const auto& known : g_display_addresses) {
+        if (known.load(std::memory_order_relaxed) == address) {
+            return true;
+        }
+    }
+    return false;
+}
+
+} // namespace Ryty
diff --git a/ryty_gpu/ryty_pro_mode.h b/ryty_gpu/ryty_pro_mode.h
new file mode 100644
index 00000000..bed4903d
--- /dev/null
+++ b/ryty_gpu/ryty_pro_mode.h
@@ -0,0 +1,128 @@
+#pragma once
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+namespace Ryty {
+
+enum class ProMode { Base, Neo1080, Neo4K };
+
+constexpr ProMode ParseProMode(std::string_view value) {
+    if (value == "1080") {
+        return ProMode::Neo1080;
+    }
+    if (value == "1" || value == "2160") {
+        return ProMode::Neo4K;
+    }
+    return ProMode::Base;
+}
+
+// Whether `key` is true in user\custom_configs\CUSA03220.json (the launcher's options).
+inline bool ConfigTrue(std::string_view key) {
+#ifdef _WIN32
+    char path[MAX_PATH];
+    const DWORD length = GetModuleFileNameA(nullptr, path, MAX_PATH);
+    if (length == 0 || length >= MAX_PATH) {
+        return false;
+    }
+    std::string config{path, length};
+    config = config.substr(0, config.find_last_of("\\/") + 1) + "user\\custom_configs\\CUSA03220.json";
+    std::FILE* file = std::fopen(config.c_str(), "rb");
+    if (!file) {
+        return false;
+    }
+    std::string text;
+    char chunk[4096];
+    while (const size_t n = std::fread(chunk, 1, sizeof(chunk), file)) {
+        text.append(chunk, n);
+    }
+    std::fclose(file);
+    const std::string quoted = "\"" + std::string{key} + "\"";
+    const size_t found = text.find(quoted);
+    if (found == std::string::npos) {
+        return false;
+    }
+    const size_t value = text.find_first_not_of(" \t\r\n:", found + quoted.size());
+    return value != std::string::npos && text.compare(value, 4, "true") == 0;
+#else
+    return false;
+#endif
+}
+
+// The number after `key` in the config (the launcher's options), or `fallback`.
+inline double ConfigNumber(std::string_view key, double fallback) {
+#ifdef _WIN32
+    char path[MAX_PATH];
+    const DWORD length = GetModuleFileNameA(nullptr, path, MAX_PATH);
+    if (length == 0 || length >= MAX_PATH) {
+        return fallback;
+    }
+    std::string config{path, length};
+    config = config.substr(0, config.find_last_of("\\/") + 1) + "user\\custom_configs\\CUSA03220.json";
+    std::FILE* file = std::fopen(config.c_str(), "rb");
+    if (!file) {
+        return fallback;
+    }
+    std::string text;
+    char chunk[4096];
+    while (const size_t n = std::fread(chunk, 1, sizeof(chunk), file)) {
+        text.append(chunk, n);
+    }
+    std::fclose(file);
+    const std::string quoted = "\"" + std::string{key} + "\"";
+    const size_t found = text.find(quoted);
+    if (found == std::string::npos) {
+        return fallback;
+    }
+    const size_t value = text.find_first_not_of(" \t\r\n:", found + quoted.size());
+    if (value == std::string::npos) {
+        return fallback;
+    }
+    char* end = nullptr;
+    const double number = std::strtod(text.c_str() + value, &end);
+    return end == text.c_str() + value ? fallback : number;
+#else
+    return fallback;
+#endif
+}
+
+// GPU.ps4_pro is true in the config (the launcher's PS4 Pro option).
+inline bool ProConfigEnabled() {
+    return ConfigTrue("ps4_pro");
+}
+
+// RYGT_PS4_PRO overrides the config (0 forces base mode); the config option means Neo 1080.
+inline ProMode GetProMode() {
+    static const ProMode mode = [] {
+        const char* value = std::getenv("RYGT_PS4_PRO");
+        if (value) {
+            return ParseProMode(std::string_view{value});
+        }
+        return ProConfigEnabled() ? ProMode::Neo1080 : ProMode::Base;
+    }();
+    return mode;
+}
+
+constexpr bool IsProMode(ProMode mode) {
+    return mode != ProMode::Base;
+}
+
+constexpr std::pair<unsigned, unsigned> ProOutputSize(ProMode mode, unsigned width,
+                                                     unsigned height) {
+    if (mode == ProMode::Neo4K) {
+        return {3840, 2160};
+    }
+    if (mode == ProMode::Neo1080) {
+        return {1920, 1080};
+    }
+    return {width, height};
+}
+
+} // namespace Ryty
