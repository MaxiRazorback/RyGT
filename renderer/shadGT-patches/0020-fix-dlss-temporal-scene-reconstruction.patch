+bool TemporalRequested() {
+    static const bool requested = [] {
+        const char* value = std::getenv("SHADGT_DLSS_TEMPORAL");
+        return value ? std::strcmp(value, "1") == 0 : EmulatorSettings.IsDlssEnabled();
+    }();
