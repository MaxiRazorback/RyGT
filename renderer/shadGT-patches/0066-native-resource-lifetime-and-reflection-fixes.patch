+            retain(mirror.begin, mirror.end);
+        }
+        std::ranges::sort(live);
+        VAddr cursor = begin;
+        for (const auto& [base, limit] : live) {
+            if (base > cursor) {
+                UnwatchPages(cursor, base);
+            }
+            cursor = std::max(cursor, limit);
+        }
+        if (cursor < end) {
+            UnwatchPages(cursor, end);
+        }
+    }
