@@ -0,0 +1,178 @@
+#include "ryty_gpu/ryty_camera_settings.h"
+#include <fstream>
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
