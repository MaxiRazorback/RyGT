+      layout.y = (pos.y - origin.y) / area.y;
+      layout.width = actual.x / area.x;
+      layout.height = actual.y / area.y;
+      store.SetAppearance(layout);
+    }
+  }
+  ImGui::End();
+  ImGui::PopStyleColor(static_cast<int>(std::size(colors)));
+  ImGui::PopStyleVar(9);
+  ImGui::PopFont();
+  if (!show)
+    CloseOverlay();
+}
+} // namespace Ryty::Camera
