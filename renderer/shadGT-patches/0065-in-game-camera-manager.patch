diff --git a/ryty_gpu/camera_math/orbit_ground.h b/ryty_gpu/camera_math/orbit_ground.h
new file mode 100644
index 00000000..6710b08d
--- /dev/null
+++ b/ryty_gpu/camera_math/orbit_ground.h
@@ -0,0 +1,66 @@
+#ifndef ORBIT_GROUND_H
+#define ORBIT_GROUND_H
+// Verified SysV interface: RunWayRayCastAdapter::cast(this, plane/material output,
+// ray origin, ray direction). Output begins with normalized world plane nx,ny,nz,d.
+typedef int (__attribute__((sysv_abi)) *GroundRay)(void*,float*,const float*,const float*);
+static inline float ground_sqrt(float x){return __builtin_sqrtf(x);}
+static inline unsigned ground_finite(float x){return x==x&&x<3.4e38f&&x> -3.4e38f;}
+static inline float ground_atan(float x){
+ // atan for |x|<=1, error below 0.000012 rad. Reduction covers our <=65 degree orbit.
+ float a=x<0?-x:x,z=a*a;
+ float p=a*(0.99997726f+z*(-0.33262347f+z*(0.19354346f+z*(-0.11643287f+z*(0.05265332f+z*(-0.01172120f))))));
+ return x<0?-p:p;
+}
+static inline void ground_restore(float* v,const float* native,unsigned char* b){
+ for(unsigned i=0;i<8;++i)v[i]=native[i];
+ if(b[100]){float* p=(float*)b;p[38]=p[39]=p[40]=p[41]=0;b[184]=0;}
+}
+static void ground_apply(float* v,unsigned char* b,const float* anchor,const float* native){
+ if(!b[192])return;
+ b[193]=1;((float*)b)[59]=0;
+ unsigned long long global=*(unsigned long long*)(b+200);
+ if(!global){ground_restore(v,native,b);return;}
+ void* organizer=*(void**)global;
+ void* root=organizer?*(void**)organizer:0;
+ if(!root||*(unsigned long long*)root!=*(unsigned long long*)(b+208)){ground_restore(v,native,b);return;}
+ void* course=*(void**)((unsigned char*)root+0x25b0);
+ void* ray=course?(unsigned char*)course+0x660:0;
+ GroundRay cast=*(GroundRay*)(b+224);
+ if(!ray||!cast||*(unsigned long long*)ray!=*(unsigned long long*)(b+216)||!*(void**)((unsigned char*)ray+8)){
+  ground_restore(v,native,b);return;
+ }
+ float origin[4]={v[0],(v[1]>anchor[1]?v[1]:anchor[1])+2.0f,v[2],0};
+ float direction[4]={0,-1,0,0},plane[8]={0};
+ ((unsigned*)b)[60]++;
+ int hit=cast(ray,plane,origin,direction);
+ // Reject no-hit, walls, ceilings, corrupt results and remote lower track layers.
+ if(hit<0||!ground_finite(plane[0])||!ground_finite(plane[1])||!ground_finite(plane[2])||!ground_finite(plane[3])||plane[1]<0.2f||plane[1]>1.01f){ground_restore(v,native,b);return;}
+ float height=-(plane[0]*v[0]+plane[2]*v[2]+plane[3])/plane[1];
+ if(!ground_finite(height)||height>origin[1]+0.01f||height<anchor[1]-50){ground_restore(v,native,b);return;}
+ ((unsigned*)b)[61]++;((float*)b)[58]=height;b[193]=2;
+ float floor=height+((float*)b)[49]/plane[1];
+ if(v[1]>=floor)return;
+ float rx=v[0]-anchor[0],ry=v[1]-anchor[1],rz=v[2]-anchor[2],newY=floor-anchor[1];
+ float oldLength=ground_sqrt(rx*rx+ry*ry+rz*rz),newLength=ground_sqrt(rx*rx+newY*newY+rz*rz);
+ if(oldLength>0.001f&&newLength>0.001f){
+  // Shortest quaternion rotates the old pivot radius to the constrained radius,
+  // preserving framing while lifting the camera above the road.
+  float x=rz*(ry-newY),z=rx*(newY-ry),w=oldLength*newLength+rx*rx+ry*newY+rz*rz;
+  float norm=ground_sqrt(x*x+z*z+w*w);
+  if(norm>0.000001f){
+   x/=norm;z/=norm;w/=norm;
+   float qx=v[4],qy=v[5],qz=v[6],qw=v[7];
+   v[4]=w*qx+x*qw-z*qy;v[5]=w*qy+z*qx-x*qz;v[6]=w*qz+z*qw+x*qy;v[7]=w*qw-x*qx-z*qz;
+   if(b[100]&&w>0.000001f){
+    // Prevent input wind-up at the boundary; reversing the stick moves immediately.
+    float sn=ground_sqrt(x*x+z*z),t=sn/w;
+    float angle=t<=1?ground_atan(t):1.5707963267948966f-ground_atan(1/t);
+    float* p=(float*)b;p[39]-=angle*114.59155902616465f;
+    if(p[39]< -65)p[39]=-65;if(p[39]>65)p[39]=65;
+    if(p[41]>0)p[41]=0;
+   }
+  }
+ }
+ ((float*)b)[59]=floor-v[1];v[1]=floor;b[193]=3;
+}
+#endif
diff --git a/ryty_gpu/camera_math/orbit_ground_apply.inc b/ryty_gpu/camera_math/orbit_ground_apply.inc
new file mode 100644
index 00000000..b0684a89
--- /dev/null
+++ b/ryty_gpu/camera_math/orbit_ground_apply.inc
@@ -0,0 +1,47 @@
+#include "orbit_motion.h"
+#include "orbit_ground.h"
+typedef long long i64;
+typedef int __attribute__((ms_abi)) (*QueryClock)(i64*);
+static void orbit_apply(float* v,unsigned char* b,const float* anchor,const float* native){
+ if(!b[40]){ground_apply(v,b,anchor,native);return;}
+ ((unsigned*)b)[21]++;
+ const volatile unsigned* sequence=(const volatile unsigned*)(b+96);
+ unsigned version=*sequence;if(version&1)return;
+ const volatile float* p=(const volatile float*)b;
+ float c=p[11],s=p[12],ch=p[13],sh=p[14],cp=p[17],sp=p[18],hc=p[19],hs=p[20];
+ unsigned pitch_enabled=b[65];
+ if(b[100]){
+  QueryClock clock=*(QueryClock*)(b+128);i64 frequency=*(i64*)(b+136),now=0;
+  if(!clock||frequency<=0||!clock(&now))return;
+  i64 previous=*(i64*)(b+144),input=*(i64*)(b+176);
+  float dt=previous&&now>=previous?(float)((double)(now-previous)/(double)frequency):0;
+  unsigned active=b[127]&&input>0&&now>=input&&((double)(now-input)/(double)frequency)<0.2;
+  MotionState state={p[38],p[39],p[40],p[41],p[42],b[184]};
+  MotionConfig config={p[26],p[27],p[28],p[29],p[30],b[124],b[125],b[126]};
+  motion_step(&state,&config,dt,active);
+  motion_sincos(state.yaw,&s,&c);motion_sincos(state.yaw*0.5f,&sh,&ch);
+  motion_sincos(state.pitch,&sp,&cp);motion_sincos(state.pitch*0.5f,&hs,&hc);pitch_enabled=1;
+  if(*sequence!=version)return;
+  *(i64*)(b+144)=now;
+  float* writable=(float*)b;writable[38]=state.yaw;writable[39]=state.pitch;
+  writable[40]=state.vx;writable[41]=state.vy;writable[42]=state.idle;b[184]=state.returning;
+ }
+ float x=v[0]-anchor[0],y=v[1]-anchor[1],z=v[2]-anchor[2];
+ float rx=c*x+s*z,ry=y,rz=-s*x+c*z;
+ float qx=v[4],qy=v[5],qz=v[6],qw=v[7];
+ float nx=ch*qx+sh*qz,ny=ch*qy+sh*qw,nz=ch*qz-sh*qx,nw=ch*qw-sh*qy;
+ if(pitch_enabled){
+  float ax=1-2*(ny*ny+nz*nz),ay=2*(nx*ny+nw*nz),az=2*(nx*nz-nw*ny);
+  float dot=ax*rx+ay*ry+az*rz;
+  float px=rx*cp+(ay*rz-az*ry)*sp+ax*dot*(1-cp);
+  float py=ry*cp+(az*rx-ax*rz)*sp+ay*dot*(1-cp);
+  float pz=rz*cp+(ax*ry-ay*rx)*sp+az*dot*(1-cp);
+  rx=px;ry=py;rz=pz;
+  float tx=nx*hc+nw*hs,ty=ny*hc+nz*hs,tz=nz*hc-ny*hs,tw=nw*hc-nx*hs;
+  nx=tx;ny=ty;nz=tz;nw=tw;
+ }
+ if(*sequence!=version)return;
+ v[0]=anchor[0]+rx;v[1]=anchor[1]+ry;v[2]=anchor[2]+rz;
+ v[4]=nx;v[5]=ny;v[6]=nz;v[7]=nw;
+ ground_apply(v,b,anchor,native);
+}
diff --git a/ryty_gpu/camera_math/orbit_motion.h b/ryty_gpu/camera_math/orbit_motion.h
new file mode 100644
index 00000000..9b659405
--- /dev/null
+++ b/ryty_gpu/camera_math/orbit_motion.h
@@ -0,0 +1,48 @@
+#ifndef ORBIT_MOTION_H
+#define ORBIT_MOTION_H
+typedef struct { float yaw,pitch,vx,vy,idle; unsigned returning; } MotionState;
+typedef struct { float x,y,speed,smoothing_ms,delay; unsigned auto_return,invert_x,invert_y; } MotionConfig;
+static inline float motion_abs(float x){return x<0?-x:x;}
+static inline float motion_wrap(float x){while(x>=360)x-=360;while(x<0)x+=360;if(x>=360)x=0;return x;}
+static inline float motion_alpha(float dt,float tau){
+ if(tau<=0)return 1;
+ float x=dt/tau;
+ // Stable exponential approximation. Return smoothing always uses tau 0.25 s.
+ return 1-1/(1+x+x*x*0.5f+x*x*x*(1.0f/6.0f));
+}
+static inline void motion_step(MotionState* s,const MotionConfig* c,float dt,unsigned active){
+ if(dt<0)dt=0;if(dt>0.05f)dt=0.05f;
+ if(!active){s->vx=s->vy=0;s->returning=0;return;}
+ float x=c->invert_x?-c->x:c->x,y=c->invert_y?c->y:-c->y;
+ unsigned moving=x!=0||y!=0;
+ if(moving){s->idle=0;s->returning=0;}else s->idle+=dt;
+ if(!moving&&c->auto_return&&s->idle>=c->delay){
+  s->returning=1;s->vx=s->vy=0;
+  float delta=s->yaw>180?360-s->yaw:-s->yaw;
+  float a=motion_alpha(dt,0.25f);
+  s->yaw=motion_wrap(s->yaw+delta*a);s->pitch-=s->pitch*a;
+  // Sub-pixel settling threshold, after the smooth return has effectively finished.
+  if(motion_abs(delta)<0.01f&&motion_abs(s->pitch)<0.01f){s->yaw=s->pitch=0;s->returning=0;}
+  return;
+ }
+ s->returning=0;
+ float a=motion_alpha(dt,c->smoothing_ms*0.001f);
+ float tx=x*c->speed,ty=y*c->speed,tau=c->smoothing_ms*0.001f;
+ float dx=tx*dt+(s->vx-tx)*tau*a,dy=ty*dt+(s->vy-ty)*tau*a;
+ s->vx+=(tx-s->vx)*a;s->vy+=(ty-s->vy)*a;
+ if(!moving&&motion_abs(s->vx)<0.01f&&motion_abs(s->vy)<0.01f)s->vx=s->vy=0;
+ s->yaw=motion_wrap(s->yaw+dx);s->pitch+=dy;
+ if(s->pitch>65){s->pitch=65;if(s->vy>0)s->vy=0;}
+ if(s->pitch< -65){s->pitch=-65;if(s->vy<0)s->vy=0;}
+}
+static inline void motion_sincos(float degrees,float* sine,float* cosine){
+ float d=motion_wrap(degrees);if(d>180)d-=360;
+ float x=d*0.01745329251994329577f,sign=1;
+ if(x>1.5707963267948966f){x=3.1415926535897932f-x;sign=-1;}
+ else if(x< -1.5707963267948966f){x=-3.1415926535897932f-x;sign=-1;}
+ float z=x*x;
+ *sine=x*(1+z*(-1.0f/6+z*(1.0f/120+z*(-1.0f/5040+z*(1.0f/362880+z*(-1.0f/39916800))))));
+ *cosine=sign*(1+z*(-0.5f+z*(1.0f/24+z*(-1.0f/720+z*(1.0f/40320+z*(-1.0f/3628800))))));
+}
+#endif
+
diff --git a/ryty_gpu/camera_math/roof_apply.inc b/ryty_gpu/camera_math/roof_apply.inc
new file mode 100644
index 00000000..15e5efc3
--- /dev/null
+++ b/ryty_gpu/camera_math/roof_apply.inc
@@ -0,0 +1,44 @@
+// Roof final-view FOV, world-height and camera-local forward distance adjustment. The original call has already built the view.
+typedef unsigned long long U64;
+typedef int (__attribute__((sysv_abi)) *RayCast)(void*,float*,const float*,const float*);
+static int finite_value(float x){return x==x&&x<3.4e38f&&x> -3.4e38f;}
+static void roof_apply(float* view,unsigned char* data){
+ float* p=(float*)data;
+ const float nativeY=view[1];p[2]=view[22];p[6]=nativeY;((unsigned*)data)[7]++;
+ unsigned fov=data[0],position=data[12];float desiredFov=p[1],requested=p[4],distance=p[5];
+ if(fov&&finite_value(desiredFov)&&desiredFov>=30&&desiredFov<=100)view[22]=desiredFov;
+ data[193]=1;p[9]=0;
+ if(!position)requested=distance=0;
+ if(!finite_value(requested))requested=0;
+ if(!finite_value(distance))distance=0;
+ float backward=-distance;
+ float x=view[4],y=view[5],z=view[6],w=view[7];
+ float targetX=view[0]+2*(x*z+w*y)*backward;
+ float baseY=nativeY+2*(y*z-w*x)*backward;
+ float targetZ=view[2]+(1-2*(x*x+y*y))*backward;
+ p[10]=0;
+ if(!finite_value(targetX)||!finite_value(baseY)||!finite_value(targetZ))return;
+ U64 global=*(U64*)(data+200);
+ void* organizer=global?*(void**)global:0;
+ void* root=organizer?*(void**)organizer:0;
+ if(!root||*(U64*)root!=*(U64*)(data+208))return;
+ void* course=*(void**)((unsigned char*)root+0x25b0);
+ void* ray=course?(unsigned char*)course+0x660:nullptr;
+ RayCast cast=*(RayCast*)(data+224);
+ if(!ray||!cast||*(U64*)ray!=*(U64*)(data+216)||!*(void**)((unsigned char*)ray+8))return;
+ // Probe the NEW X/Z after distance; ignore extra height when choosing the ray origin.
+ float origin[4]={targetX,(baseY>nativeY?baseY:nativeY)+2,targetZ,0},direction[4]={0,-1,0,0},plane[8]={0};
+ ((unsigned*)data)[60]++;
+ int hit=cast(ray,plane,origin,direction);
+ if(hit<0||!finite_value(plane[0])||!finite_value(plane[1])||!finite_value(plane[2])||!finite_value(plane[3])||plane[1]<0.2f||plane[1]>1.01f)return;
+ float ground=-(plane[0]*targetX+plane[2]*targetZ+plane[3])/plane[1];
+ if(!finite_value(ground)||ground>origin[1]+0.01f||ground<nativeY-50)return;
+ float minimum=ground+p[49]/plane[1]-baseY;
+ if(!finite_value(minimum))return;
+ data[193]=2;p[8]=minimum;p[58]=ground;((unsigned*)data)[61]++;
+ if(!position)return; // Read defaults/minimum without changing the native camera.
+ float applied=requested<minimum?minimum:requested;
+ view[0]=targetX;view[1]=baseY+applied;view[2]=targetZ;p[9]=applied;p[10]=distance;
+ if(applied>requested)data[193]=3;
+ // Preserve native orientation, native look-back and all unrelated fields.
+}
